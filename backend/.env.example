# Mi configuración local del backend.
# Desde la raíz copio esta plantilla solo si todavía no tengo backend/.env:
# cp -n backend/.env.example backend/.env
# Completo mis credenciales en backend/.env; nunca en esta plantilla pública.

# Mi servidor local. Si cambio el puerto, actualizo el proxy de Vite.
PORT=3001

# MongoDB Atlas: Connect > Drivers > Node.js.
# Utilizo la base expediente_x y sustituyo los marcadores por mis datos.
# Ejemplo de estructura (no es una conexión real):
# mongodb+srv://MI_USUARIO:MI_PASSWORD@MI_CLUSTER.mongodb.net/expediente_x?retryWrites=true&w=majority
# Codifico los caracteres reservados de la contraseña para su uso en una URL.
MONGODB_URI=

# TMDB: configuración de mi cuenta > API > API Read Access Token.
# Copio el token de lectura, sin el prefijo Bearer y sin usar la API Key corta.
# Lo utilizo para el importador y la consulta de plataformas del backend.
TMDB_READ_TOKEN=

# Cloudinary: obtengo los datos del entorno de producto que voy a utilizar.
# Cloud name identifica mi entorno; API Key y API Secret son sus credenciales.
# Los preparo ahora; todavía tengo pendiente implementar esta integración.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Reinicio npm run dev después de guardar cambios en backend/.env.
# Mantengo estos secretos en el servidor, nunca en variables VITE_ del frontend.
