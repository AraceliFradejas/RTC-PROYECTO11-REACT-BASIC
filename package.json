{
  "name": "expediente-x-archivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "start": "npm run start -w backend",
    "format": "prettier --write frontend/src backend/src backend/test frontend/vite.config.js",
    "format:check": "prettier --check frontend/src backend/src backend/test frontend/vite.config.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8"
  }
}
